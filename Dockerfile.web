FROM node:22-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY . .
# The browser calls the API directly, so this is the host-facing address.
ARG NEXT_PUBLIC_CURTAIL_API=http://localhost:8000
ENV NEXT_PUBLIC_CURTAIL_API=$NEXT_PUBLIC_CURTAIL_API
RUN npm run build

FROM node:22-slim
WORKDIR /app
ENV NODE_ENV=production
COPY --from=build /app ./
EXPOSE 3000
CMD ["npm", "start"]
